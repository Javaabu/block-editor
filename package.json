{
  "name": "javaabu-block-editor-assets",
  "private": true,
  "description": "Build and test tooling for javaabu/block-editor's TypeScript: the TipTap editor, the React components (resources/js, imported by apps as @javaabu/block-editor through javaabu/manifest) and the Blade entry.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "locales": "node scripts/locales.mjs",
    "examples": "vite --config examples/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@javaabu/forms": "github:Javaabu/react-forms#next-gen",
    "@javaabu/i18n": "github:Javaabu/i18n#build-on-git-install",
    "@javaabu/onu": "^0.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extensions": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/static-renderer": "^3.32.3",
    "@tiptap/suggestion": "^3.32.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@javaabu/forms",
      "@javaabu/i18n"
    ]
  }
}
